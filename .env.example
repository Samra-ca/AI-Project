DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/mind2machine

# Primary: Groq (used unless a real Gemini key is set below)
GROQ_API_KEY=
MODEL_NAME=openai/gpt-oss-20b

# Optional fallback/alternative: Gemini. If this is set to a real key
# (starts with "AIza"), it is used automatically instead of Groq - see
# services/model_service.py's create_model_service().
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-2.0-flash
